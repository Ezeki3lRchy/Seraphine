GameInfoInterface {
    border: none;
    background-color: transparent;
}

/* 未单独设置颜色的标签统一用主题文字色; macOS 原生 palette 会跟随系统深浅色 */
QLabel {
    color: black;
}

#summonersGamesView {
    border-radius: 6px;
    border: 1px solid rgba(0, 0, 0, 0.095);
    background-color: rgba(255, 255, 255, 0.667);
}

#gamesScrollArea,
#gamesScrollWidget {
    border: none;
    background: transparent;
}

/* 每名玩家一列, 列间细分隔线 */
PlayerColumn {
    border: none;
    border-right: 1px solid rgba(0, 0, 0, 0.095);
    background-color: transparent;
}

PlayerColumn[isLast=true] {
    border: none;
}


SummonerName {
    font: bold 15px 'Microsoft YaHei', 'Segoe UI';
    padding: 0px;
    color: black;
    border: none;
    background-color: transparent;
}

SummonerName:hover {
    color: --ThemeColorLight1;
}

SummonerName[pressed=true] {
    color: --ThemeColorLight3;
}

SummonerName:disabled {
    color: rgba(0, 0, 0, 0.43);
}

#rankLabel {
    font: bold 14px 'Segoe UI', 'Microsoft YaHei';
}

#bodyLabel {
    font: 13px 'Segoe UI', 'Microsoft YaHei';
}

#secondaryLabel {
    font: 12px 'Segoe UI', 'Microsoft YaHei';
    color: rgba(0, 0, 0, 0.6);
}

#sectionTitle {
    font: bold 13px 'Segoe UI', 'Microsoft YaHei';
    color: rgba(0, 0, 0, 0.6);
}


GameRow #kills,
GameRow #deaths,
GameRow #assists {
    font: bold 15px 'Segoe UI', 'Microsoft YaHei';
}

GameRow #slash {
    font: 15px 'Segoe UI', 'Microsoft YaHei';
    color: rgba(0, 0, 0, 0.6);
}

GameRow #kdaRatio {
    font: 12px 'Segoe UI', 'Microsoft YaHei';
    color: rgba(0, 0, 0, 0.6);
}

ChampionStatRow {
    border: none;
    background-color: transparent;
}
